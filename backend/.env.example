# Server
PORT=3000
NODE_ENV=development
# Proxy hops to trust for client IP/protocol. Set to 1 behind a load balancer (Render, Railway, Nginx).
TRUST_PROXY=

# Database: either DATABASE_URL (takes precedence; add ?sslmode=require if TLS is needed) ...
DATABASE_URL=
# ... or the individual settings
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=stylecast_erp

# JWT (JWT_SECRET is required; production needs 32+ characters, e.g. openssl rand -base64 48)
JWT_SECRET=
JWT_EXPIRES_IN=1d

# CORS: comma-separated origins allowed to call the API (* allows any). Required when NODE_ENV=production.
ALLOWED_ORIGINS=http://localhost:5173

# Failed sign-in attempts allowed per IP per 15 minutes, and sign-ups per IP per hour
LOGIN_RATE_LIMIT=10
REGISTER_RATE_LIMIT=10

# Public URLs: this API (for uploaded image links; defaults to the request host)
# and the dashboard (for links in emails)
PUBLIC_URL=
APP_URL=http://localhost:5173

# Email. Without SMTP_URL, emails print to the console in development and are skipped in production.
SMTP_URL=
MAIL_FROM=StyleCast <no-reply@stylecast.example>

# Used by npm run create-admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=

# Password for every demo account created by npm run seed
SEED_PASSWORD=password
